{
  "info": {
    "name": "AgilePop API",
    "description": "Collection de testes dos endpoints de Eventos da AgilePop API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "eventoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Criar Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Resposta contém o evento criado', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json.nome).to.eql('AgileConf Newman');",
              "    pm.collectionVariables.set('eventoId', json.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"AgileConf Newman\",\n  \"descricao\": \"Evento criado via teste automatizado do Newman\",\n  \"local\": \"São Paulo\",\n  \"categoria\": \"Tecnologia\",\n  \"dataHora\": \"2030-01-01T10:00:00\",\n  \"maxParticipantes\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "eventos" ]
        }
      }
    },
    {
      "name": "Listar Eventos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Resposta é uma lista', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "eventos" ]
        }
      }
    },
    {
      "name": "Buscar Evento por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Evento retornado tem o ID esperado', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(String(json.id)).to.eql(String(pm.collectionVariables.get('eventoId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "eventos", "{{eventoId}}" ]
        }
      }
    },
    {
      "name": "Atualizar Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Evento foi atualizado', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.nome).to.eql('AgileConf Newman Atualizada');",
              "    pm.expect(json.local).to.eql('Rio de Janeiro');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"AgileConf Newman Atualizada\",\n  \"descricao\": \"Evento atualizado via teste automatizado do Newman\",\n  \"local\": \"Rio de Janeiro\",\n  \"categoria\": \"Tecnologia\",\n  \"dataHora\": \"2030-02-01T10:00:00\",\n  \"maxParticipantes\": 150\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "eventos", "{{eventoId}}" ]
        }
      }
    },
    {
      "name": "Deletar Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "eventos", "{{eventoId}}" ]
        }
      }
    }
  ]
}